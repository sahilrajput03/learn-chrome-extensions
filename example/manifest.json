{
    "manifest_version": 3,
    "name": "Sahil - Paint background of example.com",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "https://example.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}