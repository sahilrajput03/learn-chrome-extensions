{
    "manifest_version": 3,
    "name": "Sahil - Telegram",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "https://web.telegram.org/a/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}